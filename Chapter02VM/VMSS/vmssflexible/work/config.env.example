# Copy to config.env and edit before running.
# Storage account name must be globally unique: lowercase letters/numbers, 3-24 chars.
RG="rg-vmss-flex-lab"
LOCATION="centralindia"
VNET="vnet-vmss-flex"
SUBNET="snet-web"
NSG="nsg-vmss-flex"
STORAGE="stvmssflex12345"   # CHANGE to a globally unique name
CONTAINER="scripts"
EXISTING_VM="vm-existing-web"
VMSS="vmss-flex-web"
VM_SIZE="Standard_B2s"
ADMIN_USER="azureuser"
SSH_SOURCE="YOUR_PUBLIC_IP/32"  # Replace; avoid opening SSH to the whole Internet
SSH_KEY="$HOME/.ssh/id_rsa.pub"
