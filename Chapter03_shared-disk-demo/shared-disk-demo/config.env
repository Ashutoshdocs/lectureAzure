# ---- Edit these values, then: source config.env ----
RG="rg-shareddisk-demo"
LOC="centralindia"          # region must support zones for a zonal shared disk
ZONE="1"                    # VMs and shared disk MUST be in the same zone
VNET="vnet-demo"
SUBNET="snet-app"
NSG="nsg-demo"
VM_SIZE="Standard_B2s"   # must support Premium SSD ("s" in the size name)
IMAGE="Ubuntu2204"
ADMIN_USER="azureuser"
VMS=("vm01" "vm02")

DISK_NAME="shared-disk01"
DISK_SIZE_GB="256"          # Premium SSD P15 – supports maxShares >= 2
DISK_SKU="Premium_LRS"
MAX_SHARES="2"
