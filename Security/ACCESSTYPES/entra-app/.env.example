# Copy this file to .env and fill in the values from your Entra app registration.
# Never commit the real .env to source control.

# From: Entra ID > App registrations > vm-enterprise-app > Overview
CLIENT_ID=00000000-0000-0000-0000-000000000000
TENANT_ID=00000000-0000-0000-0000-000000000000

# From: App registration > Certificates & secrets > New client secret (copy the VALUE)
CLIENT_SECRET=your-client-secret-value

# Must match the path portion of the Redirect URI in the app registration.
REDIRECT_PATH=/getAToken

# Space-separated delegated Graph scopes.
# Add GroupMember.Read.All to enable the /api/groups endpoint (needs admin consent).
SCOPE=User.Read

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-hex-string

# Set to 1 only for local debugging. Keep 0 in production.
FLASK_DEBUG=0
