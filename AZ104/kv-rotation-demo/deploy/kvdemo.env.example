# Written to /etc/kvdemo.env on the VM by scripts/04-vm-bootstrap.sh
# Only URLs and names live here. The secret VALUE is never on disk.
KEYVAULT_URL=https://<your-kv>.vault.azure.net
SECRET_NAME=app-api-key
QUEUE_ACCOUNT_URL=https://<your-storage>.queue.core.windows.net
QUEUE_NAME=kv-events
POLL_SECONDS=60
