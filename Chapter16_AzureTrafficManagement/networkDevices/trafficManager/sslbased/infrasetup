===========================================
STEP 8: CREATE TRAFFIC MANAGER PROFILE
===========================================

az network traffic-manager profile create -g tm-https-rg -n mytmprofile --routing-method Priority --unique-dns-name mytm-https-demo --ttl 30 --protocol HTTPS --port 443 --path "/"

===========================================
STEP 9: ADD ENDPOINTS
===========================================

VM1 (Priority 1)

az network traffic-manager endpoint create -g tm-https-rg --profile-name mytmprofile -n vm1 --type externalEndpoints --target <VM1-PUBLIC-IP> --priority 1

-------------------------------------------

VM2 (Priority 2)

az network traffic-manager endpoint create -g tm-https-rg --profile-name mytmprofile -n vm2 --type externalEndpoints --target <VM2-PUBLIC-IP> --priority 2

-------------------------------------------

VM3 (Priority 3)

az network traffic-manager endpoint create -g tm-https-rg --profile-name mytmprofile -n vm3 --type externalEndpoints --target <VM3-PUBLIC-IP> --priority 3

===========================================
STEP 10: VERIFY ENDPOINT STATUS
===========================================

az network traffic-manager endpoint list -g tm-https-rg --profile-name mytmprofile -o table

Expected

Endpoint    Status    Monitor Status
------------------------------------
vm1         Enabled   Online
vm2         Enabled   Online
vm3         Enabled   Online

