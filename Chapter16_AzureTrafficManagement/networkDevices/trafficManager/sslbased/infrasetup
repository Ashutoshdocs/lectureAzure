===========================================
AZURE TRAFFIC MANAGER (HTTPS) PRACTICAL
===========================================

SERVICE:
Azure Traffic Manager (Priority Routing)

Region:
Central India

===========================================
STEP 1: CREATE RESOURCE GROUP
===========================================

az group create -n tm-https-rg -l centralindia

===========================================
STEP 2: CREATE VIRTUAL MACHINES
===========================================

# Set Password

$pass="warrison@123"

# VM1

az vm create -g tm-https-rg -n vm1 --image Ubuntu2204 --size Standard_B1s --admin-username azureuser --admin-password $pass --authentication-type password

# VM2

az vm create -g tm-https-rg -n vm2 --image Ubuntu2204 --size Standard_B1s --admin-username azureuser --admin-password $pass --authentication-type password

# VM3

az vm create -g tm-https-rg -n vm3 --image Ubuntu2204 --size Standard_B1s --admin-username azureuser --admin-password $pass --authentication-type password

===========================================
STEP 3: OPEN HTTP & HTTPS PORTS
===========================================

# VM1

az network nsg rule create -g tm-https-rg --nsg-name vm1NSG --name Allow-HTTP --priority 1000 --direction Inbound --access Allow --protocol Tcp --destination-port-ranges 80

az network nsg rule create -g tm-https-rg --nsg-name vm1NSG --name Allow-HTTPS --priority 1010 --direction Inbound --access Allow --protocol Tcp --destination-port-ranges 443

# VM2

az network nsg rule create -g tm-https-rg --nsg-name vm2NSG --name Allow-HTTP --priority 1000 --direction Inbound --access Allow --protocol Tcp --destination-port-ranges 80

az network nsg rule create -g tm-https-rg --nsg-name vm2NSG --name Allow-HTTPS --priority 1010 --direction Inbound --access Allow --protocol Tcp --destination-port-ranges 443
# VM3

az network nsg rule create -g tm-https-rg --nsg-name vm3NSG --name Allow-HTTP --priority 1000 --direction Inbound --access Allow --protocol Tcp --destination-port-ranges 80

az network nsg rule create -g tm-https-rg --nsg-name vm3NSG --name Allow-HTTPS --priority 1010 --direction Inbound --access Allow --protocol Tcp --destination-port-ranges 443

===========================================
STEP 4: GET PUBLIC IPs
===========================================

az vm list-ip-addresses -g tm-https-rg -o table

Example

VM1 : xx.xx.xx.xx
VM2 : yy.yy.yy.yy
VM3 : zz.zz.zz.zz

===========================================
STEP 5: CONNECT TO EACH VM
===========================================

VM1

ssh azureuser@<VM1-PUBLIC-IP>

VM2

ssh azureuser@<VM2-PUBLIC-IP>

VM3

ssh azureuser@<VM3-PUBLIC-IP>

